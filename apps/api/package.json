{
  "name": "@amara/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/seed.ts src/backup-mongo.ts --format esm --target node20 --clean --noExternal @amara/shared --noExternal @amara/sync --noExternal @amara/database",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "backup:mongo": "tsx src/backup-mongo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@amara/database": "*",
    "@amara/shared": "*",
    "@amara/sync": "*",
    "@noble/hashes": "^1.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
